# YanPub Docker 部署配置
# 复制此文件为 .env 并按需修改

# Playground 服务端口
YANPUB_PORT=8080

# Python 基础镜像（构建时使用）
# 国内加速: docker.m.daocloud.io/library/python:3.12-slim（默认）
# 官方镜像: python:3.12-slim
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim

# 可选: 安装 Racket 运行时（明道语言需要，镜像增加约 250MB）
# 设为 1 启用，0 关闭（默认）
INSTALL_RACKET=0

# 可选: 安装 LLVM/clang（翰语 JIT 原生执行，镜像增加约 400MB）
# 设为 1 启用，0 关闭（默认，翰语使用 Python AST 解释器回退）
INSTALL_LLVM=0

# ---- Docker 资源限制（按服务器内存调整） ----

# 容器内存上限（影响 Docker cgroup 限制，超限会被 OOM Kill）
# 2GB 服务器: 900M（默认，留 ~1.1GB 给系统+Docker daemon）
# 4GB 服务器: 1500M
# 8GB+ 服务器: 2000M
YANPUB_MEMORY_LIMIT=900M

# 容器 CPU 核数上限
YANPUB_CPU_LIMIT=2.0

# ---- 安全限制（资源耗尽防护） ----

# 同时最大代码执行数（防止并发攻击耗尽 CPU/内存）
# 2GB 服务器建议 2-3，4GB+ 可调到 5
YANPUB_MAX_CONCURRENT_EXEC=3

# 执行端点每 IP 每分钟最大请求数
YANPUB_EXEC_RATE_LIMIT=5

# WebSocket 执行每连接每分钟最大次数
YANPUB_WS_EXEC_RATE_LIMIT=15

# 最大代码长度（字符）
YANPUB_MAX_CODE_LENGTH=65536

# 沙箱最大内存（MB）
YANPUB_SANDBOX_MAX_MEMORY_MB=512
